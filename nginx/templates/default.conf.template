map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

log_format no_query '$remote_addr - $remote_user [$time_local] '
                    '"$request_method $uri $server_protocol" $status $body_bytes_sent '
                    '$request_time $upstream_response_time "$http_user_agent"';

upstream fastapi_backend {
    server ${NGINX_BACKEND_UPSTREAM};
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    access_log /var/log/nginx/access.log no_query;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    include /etc/nginx/snippets/proxy-routes.conf;

    location /assets/ {
        try_files $uri =404;
        access_log off;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}