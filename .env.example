# SQLite is the development default. PostgreSQL can be configured with a SQLAlchemy URL.
DATABASE_URL=sqlite:///./co_tuong.db

# Start the local Redis service with: docker compose up -d redis
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
PUBLIC_APP_URL=http://localhost:5173
# Comma-separated exact origins. Replace local development origins in production.
CORS_ALLOWED_ORIGINS=http://localhost:8443,http://127.0.0.1:8443,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001,http://localhost:8002,http://127.0.0.1:8002

# Local Nginx proxy (Docker forwards to host-run FastAPI and Vite services).
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_HTTP_PORT=8002
NGINX_BACKEND_UPSTREAM=host.docker.internal:8000
NGINX_FRONTEND_UPSTREAM=host.docker.internal:8443
# Set real domain, email, and external certificate/webroot directories in .env
# only when configuring Compose production TLS; do not store private keys here.
# NGINX_SERVER_NAME=
# CERTBOT_EMAIL=
# LETSENCRYPT_DIR=
# CERTBOT_WEBROOT_DIR=

# React sends account, room, and PvE commands through the native WebSocket RPC.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Set a unique random value with at least 32 characters before starting the API.
JWT_SECRET=replace-with-a-random-secret-of-32-or-more-characters
ACCESS_TOKEN_MINUTES=15

# Gmail SMTP (use an App Password; do not use your normal Google password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_EMAIL=your-account@gmail.com
SMTP_FROM_NAME=Co Tuong
SMTP_USE_SSL=false
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10

# For SendGrid, replace the SMTP settings above with:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# SMTP_FROM_EMAIL=your-verified-sender@example.com
# SMTP_USE_SSL=false
# SMTP_STARTTLS=true
