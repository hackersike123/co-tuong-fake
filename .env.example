# CHỈ LÀ MẪU — không dùng các giá trị giữ chỗ làm thông tin xác thực.
# Bản tiếng Anh: .env.example.en; hướng dẫn tiếng Anh: ENV_CONFIG.en.md.
# Nếu dự án đã có .env, hãy giữ nguyên; không chép đè bằng file này.
# Tạo từng bí mật riêng bằng: openssl rand -hex 32
# Không commit .env, .env.compose.local hoặc file nào chứa bí mật.

# -----------------------------------------------------------------------------
# Chế độ ứng dụng và thông tin PostgreSQL/Redis dùng cho Docker Compose
# -----------------------------------------------------------------------------
APP_ENV=local
POSTGRES_DB=co_tuong
POSTGRES_USER=co_tuong
POSTGRES_PASSWORD=THAY_BANG_BI_MAT_NGAU_NHIEN_64_KY_TU_HEX
REDIS_PASSWORD=THAY_BANG_BI_MAT_KHAC_64_KY_TU_HEX
REDIS_PORT=6379
JWT_SECRET=THAY_BANG_BI_MAT_NGAU_NHIEN_TOI_THIEU_32_KY_TU

# -----------------------------------------------------------------------------
# Cài đặt backend khi chạy trực tiếp trên máy phát triển
# Docker Compose ghi đè DATABASE_URL và REDIS_URL bên trong container backend
# để kết nối các dịch vụ PostgreSQL và Redis riêng trong mạng Compose.
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./co_tuong.db
REDIS_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:${REDIS_PORT}/0
ACCESS_TOKEN_MINUTES=15
AUTH_COOKIE_SECURE=false
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Cài đặt frontend và địa chỉ website
# -----------------------------------------------------------------------------
# Để trống khi frontend và API cùng origin; Nginx chuyển tiếp /api và WebSocket trong Docker.
VITE_API_BASE_URL=
# Địa chỉ backend mà Vite dùng khi chạy frontend trên máy phát triển.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Origin chuẩn dùng để tạo liên kết trong thư mời và email tài khoản.
PUBLIC_APP_URL=http://localhost:8002
# Các origin chính xác, phân cách bằng dấu phẩy; phải khớp giao thức, tên máy chủ và port trên trình duyệt.
# Không dùng *, đường dẫn, query string hoặc thông tin xác thực trong origin.
CORS_ALLOWED_ORIGINS=http://localhost:8002,http://127.0.0.1:8002,http://localhost:8443,http://127.0.0.1:8443,http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Địa chỉ và port lắng nghe trên máy phát triển
# -----------------------------------------------------------------------------
# Giữ các dịch vụ ở loopback. Truy cập công khai phải đi qua Nginx HTTPS hoặc tunnel.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_HTTP_PORT=8002

# -----------------------------------------------------------------------------
# SMTP — cần thiết cho đăng ký/xác minh tài khoản, đặt lại mật khẩu và thư mời
# -----------------------------------------------------------------------------
# Để trống nếu chưa cấu hình SMTP; các chức năng email sẽ trả về lỗi 503.
# Gmail: dùng smtp.gmail.com:587 và Google App Password, không dùng mật khẩu đăng nhập.
# SMTP_USERNAME phải là địa chỉ đăng nhập đầy đủ; SMTP_FROM_EMAIL phải là tài khoản đó hoặc alias đã được cấp quyền gửi.
# Nếu dùng implicit TLS: port 465, SMTP_USE_SSL=true, SMTP_STARTTLS=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Kỳ Tiên Hội
SMTP_USE_SSL=false
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10

# -----------------------------------------------------------------------------
# Gọi thoại/video trực tuyến — STUN mặc định; TURN cần thiết với một số NAT/firewall
# -----------------------------------------------------------------------------
RTC_STUN_URLS=stun:stun.l.google.com:19302
# Điền URL TURN và thông tin đăng nhập do nhà cung cấp TURN cấp; để trống nếu chưa có.
RTC_TURN_URLS=
RTC_TURN_USERNAME=
RTC_TURN_CREDENTIAL=

# -----------------------------------------------------------------------------
# TLS / ACME trực tiếp cho production — chỉ cấu hình khi đã có DNS và chứng chỉ.
# Đặt thư mục chứng chỉ và webroot bên ngoài repository.
# -----------------------------------------------------------------------------
# NGINX_SERVER_NAME=chess.example.com
# CERTBOT_EMAIL=ops@example.com
# LETSENCRYPT_DIR=/srv/co-tuong/letsencrypt
# CERTBOT_WEBROOT_DIR=/srv/co-tuong/certbot