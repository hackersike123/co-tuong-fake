# Mẫu triển khai TLS/ACME trực tiếp. Thay mọi giá trị mẫu và trỏ DNS về máy chủ này.
APP_ENV=production
POSTGRES_DB=co_tuong
POSTGRES_USER=co_tuong
POSTGRES_PASSWORD=THAY_BANG_BI_MAT_NGAU_NHIEN_64_KY_TU_HEX
REDIS_PASSWORD=THAY_BANG_BI_MAT_KHAC_64_KY_TU_HEX
JWT_SECRET=THAY_BANG_BI_MAT_NGAU_NHIEN_TOI_THIEU_32_KY_TU
AUTH_COOKIE_SECURE=true
NGINX_BIND_ADDRESS=0.0.0.0
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
NGINX_BACKEND_UPSTREAM=backend:8000
NGINX_SERVER_NAME=chess.example.com
PUBLIC_APP_URL=https://chess.example.com
CORS_ALLOWED_ORIGINS=https://chess.example.com
VITE_API_BASE_URL=
CERTBOT_EMAIL=ops@example.com
LETSENCRYPT_DIR=/srv/co-tuong/letsencrypt
CERTBOT_WEBROOT_DIR=/srv/co-tuong/certbot
LOG_LEVEL=INFO
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=THAY_BANG_TEN_DANG_NHAP_SMTP
SMTP_PASSWORD=THAY_BANG_BI_MAT_SMTP
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Kỳ Tiên Hội
SMTP_USE_SSL=false
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
RTC_STUN_URLS=stun:stun.l.google.com:19302
RTC_TURN_URLS=
RTC_TURN_USERNAME=
RTC_TURN_CREDENTIAL=