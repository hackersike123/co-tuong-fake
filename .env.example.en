# TEMPLATE ONLY — do not use the placeholders as credentials.
# Keep an existing .env; do not overwrite it with this template.
# Generate each secret separately with: openssl rand -hex 32
# Never commit .env or any other file containing secrets.

# Application mode and Docker Compose database/cache credentials
APP_ENV=local
POSTGRES_DB=co_tuong
POSTGRES_USER=co_tuong
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_64_CHAR_HEX_SECRET
REDIS_PASSWORD=REPLACE_WITH_A_DIFFERENT_UNIQUE_64_CHAR_HEX_SECRET
REDIS_PORT=6379
JWT_SECRET=REPLACE_WITH_A_THIRD_RANDOM_SECRET_AT_LEAST_32_CHARS

# Host-run backend settings. Compose overrides both URLs inside its backend container.
DATABASE_URL=sqlite:///./co_tuong.db
REDIS_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:${REDIS_PORT}/0
ACCESS_TOKEN_MINUTES=15
AUTH_COOKIE_SECURE=false
LOG_LEVEL=INFO

# Frontend and public-origin settings
# Leave empty for same-origin requests; Nginx proxies /api and WebSockets in Docker.
VITE_API_BASE_URL=
# Backend target for Vite host development.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Canonical origin used to build links in invitations and account email.
PUBLIC_APP_URL=http://localhost:8002
# Comma-separated exact origins; match scheme, hostname, and port. No wildcards or paths.
CORS_ALLOWED_ORIGINS=http://localhost:8002,http://127.0.0.1:8002,http://localhost:8443,http://127.0.0.1:8443,http://localhost:5173,http://127.0.0.1:5173

# Local listener bindings. Keep services on loopback; publish them only through HTTPS Nginx/tunnel.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_HTTP_PORT=8002

# SMTP is required for registration/verification, password reset, and invitations.
# Leave blank until configured. Gmail uses smtp.gmail.com:587 with an App Password.
# Implicit TLS uses port 465, SMTP_USE_SSL=true, SMTP_STARTTLS=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Kỳ Tiên Hội
SMTP_USE_SSL=false
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10

# WebRTC voice/video calls. STUN is configured by default; TURN is needed on some NATs/firewalls.
RTC_STUN_URLS=stun:stun.l.google.com:19302
# Set TURN URLs and provider-issued credentials; leave blank if TURN is not configured.
RTC_TURN_URLS=
RTC_TURN_USERNAME=
RTC_TURN_CREDENTIAL=

# Direct production TLS/ACME only; keep certificate and webroot directories outside the repository.
# NGINX_SERVER_NAME=chess.example.com
# CERTBOT_EMAIL=ops@example.com
# LETSENCRYPT_DIR=/srv/co-tuong/letsencrypt
# CERTBOT_WEBROOT_DIR=/srv/co-tuong/certbot
